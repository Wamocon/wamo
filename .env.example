# WAMO: Vorlage fuer lokale Schluessel und Einstellungen.
# Kopieren nach ".env" im Hauptordner und Werte eintragen. Die .env wird NIE committet.

# --- Pflicht fuer Gespraeche (Start mit Claude und Soniox) ---
SONIOX_API_KEY=
ANTHROPIC_API_KEY=
# Nur bei Organisationsschluesseln ohne Workspace-Bindung: ID des Workspace (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=

# --- Modelle und Stimme ---
CLAUDE_MODEL_FAST=claude-haiku-5-5
SONIOX_STT_URL=wss://stt-rt.eu.soniox.com/transcribe-websocket
SONIOX_TTS_URL=wss://tts-rt.eu.soniox.com/tts-websocket
SONIOX_VOICE=Nina
MIN_INTERRUPT_WORDS=1

# --- Eigener WAMO-Supabase auf Sokrates-2 (Anmeldung und Gedaechtnis) ---
# HTTPS ueber wamo-caddy (Zertifikat der WAMO-CA); setzt scripts/wamo_db_rolle.py
SUPABASE_URL=https://192.168.178.136:55443
# Oeffentliches Root-Zertifikat der WAMO-CA (absoluter Pfad); setzt scripts/wamo_db_rolle.py
WAMO_CA_FILE=
# Oeffentlicher Anon-/Publishable-Key (fuer die Token-Pruefung); setzt scripts/wamo_db_rolle.py
SUPABASE_PUBLISHABLE_KEY=
WAMO_DB_SCHEMA=wamo_dev
# Direkter Postgres-Zugang als Rolle wamo_core, mit ?sslmode=verify-full; setzt scripts/wamo_db_rolle.py
WAMO_DATABASE_URL=
# Nur auf Admin-PCs (voice-core/wamo_admin.py): python scripts/wamo_db_rolle.py --rolle wamo_admin
WAMO_ADMIN_DATABASE_URL=

# --- Ort, Begruessung, Oberflaeche ---
WAMO_CITY=Eschborn
WAMO_TIMEZONE=Europe/Berlin
PIPECAT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Entwicklungsauftraege (Claude Code mit ECC und REA) ---
# Standard aus: erst einschalten, wenn Auftraege isoliert laufen (eigener Benutzer, Sandbox).
WAMO_ENTWICKLUNG=aus
# Wo Auftraege laufen: sokrates2 (Standard, Sandbox als Benutzer wamo) oder lokal (nur ausdruecklich, ohne Abschottung)
WAMO_ENTWICKLUNG_ORT=sokrates2
# SSH-Ziel und Schluessel nur fuer Auftraege (Forced Command auf dem Dispatcher, keine Shell)
WAMO_ENTWICKLUNG_SSH_ZIEL=wamo@192.168.178.136
WAMO_ENTWICKLUNG_SSH_SCHLUESSEL=
# Claude-Zugang der Auftraege: jedes Profil nutzt seinen eigenen (Max-Token oder API-Schluessel, Karte Modellzugang).
# Nur das hier genannte Profil (UUID) darf ohne eigenen Zugang den Zugang aus /etc/wamo/geheim.env nutzen; leer = das
# Profil aus WAMO_CLAUDE_SCHLUESSEL_PROFIL. Fuer alle anderen startet ohne eigenen Zugang kein Auftrag.
WAMO_ENTWICKLUNG_SERVERZUGANG_PROFIL=
# Nur bei WAMO_ENTWICKLUNG_ORT=lokal: eigener Ordner nur fuer WAMO-Auftraege, nie der Ordner mit anderen
# Projekten oder dem WAMO-Repo.
WAMO_PROJECTS_DIR=D:\IDEA\WAMO-Auftraege
# Befehlskriterien der Abnahme ("befehl: pytest -q") nur bei WAMO_ENTWICKLUNG_ORT=lokal und nur mit dem Wert ja (Standard aus).
# Dabei laeuft Projektcode (conftest, Makefile, Tests) ohne Hook und ohne Sandbox mit den Rechten des Kerns. Aus: das Modell
# formuliert stattdessen Aussagen, die ein kleines Modell beurteilt. Nicht auf Sokrates-2 (dort gibt es keinen Ausfuehrer).
WAMO_ABNAHME_BEFEHLE=
# Pruefbares Ziel: WAMO leitet fuer Entwicklungsauftraege selbst ein bis drei messbare Kriterien ab und nennt sie in einem
# Satz, der Auftrag laeuft dann in Runden (Standard an, leer = an; aus, 0, nein oder off bringen den frueheren Prompt zurueck).
WAMO_PERSONA_ABNAHME=
# Büro (Kern auf Sokrates-2, WAMO_BETRIEB=buero): Entwicklungsaufträge laufen dort nur über den Kern-Kanal des Dispatchers.
# Diese Werte gehören NICHT in die .env. Sie stehen im Drop-in /etc/systemd/system/wamo-core@.service.d/wamo-entwicklung-buero.conf
# auf Sokrates-2, das nur "wamo-job-kern-einrichten.sh schalter an <release> --profil <user_id>" schreibt (infra/sokrates2/README.md).
# WAMO_ENTWICKLUNG bleibt dort aus und zählt im Büro nicht. Fehlt eine Variable oder ist sie ungültig, bleiben die Aufträge im Büro
# aus. Platzhalter zur Orientierung (auskommentiert; die Kern-Umgebung auf Sokrates-2 übernimmt kein WAMO_ENTWICKLUNG*):
# WAMO_ENTWICKLUNG_BUERO=aus
# WAMO_ENTWICKLUNG_ORT=sokrates2
# WAMO_ENTWICKLUNG_PROFILE=<user_id des Admins, mehrere durch Komma getrennt>
# WAMO_ENTWICKLUNG_KOSTEN_AUFTRAG_USD=<Grenze je Auftrag in USD, Punkt als Dezimaltrenner, zum Beispiel 3>
# WAMO_ENTWICKLUNG_KOSTEN_TAG_USD=<Grenze je Tag und Profil in USD, zum Beispiel 10>
# WAMO_ENTWICKLUNG_BEFEHLE_BUERO=aus

# --- Betrieb ---
WAMO_LOG_LEVEL=INFO
WAMO_MAX_SITZUNG_MIN=120
# Eine Sitzung je Profil: eine neue Sitzung loest die laufende desselben Profils ab (Standard an, aus schaltet ab)
WAMO_SITZUNG_EINZELN=
# Hoechstalter der Anmeldung in Stunden ab Passwort und Code (Standard 168, also 7 Tage; hoechstens 720)
WAMO_ANMELDUNG_MAX_STUNDEN=
# Lange Werkzeugausgaben werden ab so vielen Zeichen gekuerzt, bevor sie in den Kontext des Sprachmodells gehen; das Original
# bleibt nur im Arbeitsspeicher der Sitzung (Werkzeug ausgabe_nachladen). Standard 3000, 0 schaltet das Kuerzen ganz ab.
WAMO_AUSGABE_SCHWELLE=
# Nur im Kern auf Sokrates-2 (/etc/wamo/core.env, gesetzt von scripts/wamo_kern_sokrates2.py token): zweites
# Geheimnis fuer Freigaben kritischer PC-Aktionen. Lokal erzeugt der Kern es selbst je Host-Start; hier leer lassen.
WAMO_PC_HOST_FREIGABE=

# --- Eigene Modelle auf den Sparks (Phase P4, nur ueber LiteLLM) ---
LITELLM_BASE_URL=http://192.168.178.75:4000/v1
LITELLM_API_KEY=
# Anbieter je Baustein: claude (Standard) oder litellm; Modell = Alias aus "uv run python eval/abnahme.py --liste"
WAMO_LLM_ANBIETER=
WAMO_LLM_MODELL=
WAMO_LLM_LERNEN=
WAMO_LLM_LERNEN_MODELL=
WAMO_LLM_VISION=
WAMO_LLM_VISION_MODELL=
# Leer: Zusammenfassung mit dem Gespraechsmodell
WAMO_LLM_ZUSAMMENFASSUNG=
WAMO_LLM_ZUSAMMENFASSUNG_MODELL=
# Rueckfall auf Claude, wenn LiteLLM nicht nutzbar ist: leer oder claude (alle Bausteine), aus (keiner) oder
# eine Liste wie gespraech,zusammenfassung. Ohne Rueckfall bricht der Baustein ab und nichts geht an Claude.
WAMO_LLM_RUECKFALL=
# Zusaetzliche Parameter je LiteLLM-Anfrage als JSON-Objekt, z. B. {"reasoning_effort": "none"}
WAMO_LLM_EXTRA=

# --- Websuche: anthropic (Standard) oder searxng (im Haus, caesar) ---
WAMO_SUCHE=
# z. B. http://192.168.178.64:8080
WAMO_SEARXNG_URL=

# --- Modellzugang je Profil (voice-core/modellzugang.py) ---
# Zwei Arten: eigener Claude-Schluessel (Standard Haiku) oder nur Hausmodelle (LiteLLM und SearXNG, nie Anthropic).
# Ohne eigenen Schluessel gilt automatisch "nur Hausmodelle". Dafuer muessen WAMO_LLM_MODELL (Gespraech, Lernen,
# Zusammenfassung) und WAMO_LLM_VISION_MODELL (Bildschirm) gesetzt sein, ausserdem LITELLM_* und WAMO_SEARXNG_URL.
# Hauptschluessel fuer die eigenen Claude-Schluessel (AES-256-GCM in der Datenbank), nur im Kern, nie committen.
# Erzeugen: cd voice-core && uv run python modellzugang.py kek-erzeugen   (Verlust = alle Schluessel neu hinterlegen)
WAMO_SCHLUESSEL_KEK=
# Alte Hauptschluessel (kommagetrennt) nur waehrend eines Wechsels
WAMO_SCHLUESSEL_KEK_ALT=
# ANTHROPIC_API_KEY oben ist der Schluessel einer Person und gilt nur fuer das Profil mit dieser user_id
# (wamo_admin.py modellzugang zeigt sie), fuer niemanden sonst. Besser: Schluessel mit modellzugang.py hinterlegen
# und ANTHROPIC_API_KEY entfernen.
WAMO_CLAUDE_SCHLUESSEL_PROFIL=
