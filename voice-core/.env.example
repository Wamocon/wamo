# WAMO Voice-Core: alle Einstellungen, die der Code liest. Keine Werte committen.
# Der Voice-Core lädt die .env im Hauptordner (oder hier in voice-core/).
# Leere Zeilen bedeuten: Standard aus dem Code (steht im Kommentar).

# --- Pflicht für Gespräche ---
# Spracherkennung und Sprachausgabe
SONIOX_API_KEY=
# Sprachmodell, Websuche, Bildschirm-Auswertung und Lernen
ANTHROPIC_API_KEY=
# Nur bei Organisationsschluesseln ohne Workspace-Bindung: ID des Workspace (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=

# --- Modelle ---
# Gesprächsmodell (Standard claude-haiku-5-5)
CLAUDE_MODEL_FAST=
# Modell für die Websuche (Standard claude-haiku-5-5)
SEARCH_MODEL=
# Bildmodell für bildschirm_ansehen und auf_bildschirm_klicken (Standard claude-sonnet-5-5)
VISION_MODEL=

# --- Eigene Modelle über LiteLLM (Ausbaustufe P4, llm_anbieter.py) ---
# Nur über das Gateway, nie direkt an die Adressen der Sparks.
LITELLM_BASE_URL=
LITELLM_API_KEY=
# Anbieter je Baustein: claude (Standard) oder litellm. Das Modell ist bei litellm ein Alias des Gateways
# (Liste: uv run python eval/abnahme.py --liste), bei claude eine Claude-ID (Standard siehe oben).
# Gespräch
WAMO_LLM_ANBIETER=
WAMO_LLM_MODELL=
# Lernen aus dem Gespräch
WAMO_LLM_LERNEN=
WAMO_LLM_LERNEN_MODELL=
# Bildschirm ansehen und klicken (braucht ein Bildmodell)
WAMO_LLM_VISION=
WAMO_LLM_VISION_MODELL=
# Zusammenfassung langer Gespräche; leer: mit dem Gesprächsmodell
WAMO_LLM_ZUSAMMENFASSUNG=
WAMO_LLM_ZUSAMMENFASSUNG_MODELL=
# Ist LiteLLM nicht nutzbar (Schlüssel, Gateway, Modell): leer oder claude (Standard, alle Bausteine) wechselt
# mit Fehlermeldung zu Claude, aus bricht stattdessen ab (dann geht für den Baustein nichts an Claude), eine
# Liste wie gespraech,zusammenfassung erlaubt den Rückfall nur dort. Die Sprache läuft weiter über Soniox.
WAMO_LLM_RUECKFALL=
# Zusätzliche Parameter je LiteLLM-Anfrage als JSON-Objekt, z. B. {"reasoning_effort": "none"}. Was das
# OpenAI-SDK nicht kennt, geht als extra_body mit, z. B. {"chat_template_kwargs": {"enable_thinking": false}}.
WAMO_LLM_EXTRA=

# --- Websuche ---
# anthropic (Standard, Claude-Websuche) oder searxng (eigene Instanz, Ergebnisse gekürzt und als Daten markiert)
WAMO_SUCHE=
# Adresse von SearXNG, z. B. http://192.168.178.64:8080 (caesar). Pflicht bei WAMO_SUCHE=searxng: fehlt sie,
# schlägt die Suche fehl, statt still die Cloud-Suche zu nehmen.
WAMO_SEARXNG_URL=

# --- Soniox ---
# Endpunkte (Standard: EU-Spracherkennung und Soniox-Sprachausgabe)
SONIOX_STT_URL=
SONIOX_TTS_URL=
# Stimme aus der Bibliothek oder UUID einer eigenen Stimme (Standard Bryce)
SONIOX_VOICE=
# Fachbegriffe für die Spracherkennung, kommagetrennt. Ohne Eintrag gilt die Liste in bot.py,
# ein leerer Wert schaltet sie ab.
# SONIOX_TERMS=WAMO, WAMOCON, Eschborn, VS Code

# --- Gesprächsverhalten ---
# Wörter ohne Rückmeldelaute, ab denen WAMO unterbrochen wird ("Doch" reicht, "mhm" nicht)
MIN_INTERRUPT_WORDS=1
# Begrüßung beim Verbinden, {name} wird durch den Profilnamen ersetzt; leer schaltet sie ab
# (Standard: Hallo {name}, WAMO ist bereit.)
# WAMO_GREETING=Hallo {name}, WAMO ist bereit.
# Kanal, der in der Sitzung gespeichert wird (Standard web)
WAMO_CHANNEL=
# Nach so vielen neuen Sätzen lernt WAMO im laufenden Gespräch (Standard 4)
LEARN_EVERY_USER_TURNS=
# Zusammenfassung langer Gespräche ab so vielen Tokens, Ziel danach (Standard 60000 und 25000)
SUMMARY_TRIGGER_TOKENS=
SUMMARY_TARGET_TOKENS=
# Satzende-Erkennung in Sekunden (Standard 1.0, 1.5 und 3.0)
SMART_TURN_STOP_SECS=
TURN_INCOMPLETE_SHORT_SECS=
TURN_INCOMPLETE_LONG_SECS=
# Weiche Unterbrechung: höchstens so viele Wörter nach einem Einwurf, Ton-Verzug in Sekunden
# (Standard 3 und 0.5)
SOFT_INTERRUPT_MAX_WORDS=
SOFT_INTERRUPT_LAG_SECS=

# --- Ort und Zeit ---
# Ort für die Websuche (Standard Eschborn) und Zeitzone (Standard Europe/Berlin)
WAMO_CITY=
WAMO_TIMEZONE=

# --- Anmeldung (Supabase-Stack supabase-wamo auf Sokrates-2) ---
# HTTPS über wamo-caddy; GoTrue stellt Tokens mit iss = SUPABASE_URL/auth/v1 aus.
# Nur https:// (http:// nur über Loopback), sonst lehnt der Voice-Core jede Anmeldung ab.
SUPABASE_URL=https://192.168.178.136:55443
# Öffentliches Root-Zertifikat der WAMO-CA (absoluter Pfad zu infra/sokrates2/wamo-ca.crt). Gilt nur für
# Verbindungen zum WAMO-Stack (JWKS, GoTrue, Postgres), nicht für Claude, Soniox oder die Websuche.
# Gesetzt, aber unlesbar: Start bricht ab bzw. Datenbank gilt als nicht erreichbar.
WAMO_CA_FILE=
# Öffentlicher Publishable Key (sb_publishable_...), nur für den HS256-Rückfall der Token-Prüfung
SUPABASE_PUBLISHABLE_KEY=
# Nur setzen, wenn der Aussteller (iss) der Tokens nicht SUPABASE_URL/auth/v1 ist
WAMO_AUTH_ISSUER=
# Von welchen Seiten Sitzungen starten dürfen, kommagetrennt
# (Standard http://localhost:3000,http://127.0.0.1:3000)
PIPECAT_ALLOWED_ORIGINS=

# --- Datenbank (Gedächtnis und Profile) ---
# Postgres als Rolle wamo_core über Supavisor (Port 55322, Benutzer wamo_core.wamo), mit TLS:
# ...@192.168.178.136:55322/postgres?sslmode=verify-full (Prüfung gegen WAMO_CA_FILE). Mit WAMO_CA_FILE gilt
# ohne sslmode verify-full; disable, allow, prefer oder require sperren die Datenbank (Konfigurationsfehler).
# Ohne Eintrag: Gedächtnis aus und Anmeldung gesperrt.
WAMO_DATABASE_URL=
# Verwaltung (nur wamo_admin.py): Postgres als Rolle wamo_admin. Darf Profile anlegen und
# gemeinsame Vorschläge freigeben; der Voice-Core nutzt diese Verbindung nie.
WAMO_ADMIN_DATABASE_URL=
# wamo_dev, wamo_test oder wamo_prod (Standard wamo_dev)
WAMO_DB_SCHEMA=

# --- Sitzungen und Protokoll ---
# Höchstdauer einer Sitzung in Minuten (Standard 120); das Profil wird jede Minute neu geprüft
WAMO_MAX_SITZUNG_MIN=
# Eine Sitzung je Profil (sitzungen.py): eine neue Sitzung desselben Profils löst die laufende ab, die PC-Sperre geht
# auf die neue über. Standard an; aus, off, 0, false oder nein schalten ab. Andere Profile bleiben unberührt.
WAMO_SITZUNG_EINZELN=
# Höchstalter der Anmeldung in Stunden, gemessen ab Passwort und Code (Claim amr im Token, auth_gate.py). Standard 168
# (7 Tage), erlaubt mehr als 0 und höchstens 720. Tokens ohne amr werden abgelehnt; eine laufende Sitzung endet beim
# Überschreiten mit einer Meldung, die Oberfläche meldet dann ab.
WAMO_ANMELDUNG_MAX_STUNDEN=
# Log-Stufe (Standard INFO). INFO enthält keine Gesprächsinhalte, DEBUG schon.
WAMO_LOG_LEVEL=

# --- PC-Host und Entwicklungsaufträge (nur Rolle admin) ---
# off schaltet die PC-Werkzeuge ganz ab (Standard on). Auch eingerichtet sind sie je Sitzung erst
# aus und werden in der Oberfläche eingeschaltet.
WAMO_PC_HOST=
# Nur Büro (Kern auf Sokrates-2, /etc/wamo/core.env): zweites Geheimnis neben WAMO_PC_HOST_TOKEN für Freigaben
# kritischer PC-Aktionen (pc_freigaben.py). Am PC liegt es in %LOCALAPPDATA%\WAMO\host-freigabe; übertragen mit
# python scripts\wamo_kern_sokrates2.py token. Fehlt es, lässt sich im Büro nichts freigeben. Lokal (stdio) erzeugt
# der Kern es je Host-Start selbst; dann leer lassen.
WAMO_PC_HOST_FREIGABE=
# Entwicklungsaufträge an Claude Code: an oder aus (Standard aus)
WAMO_ENTWICKLUNG=
# Ort der Aufträge: sokrates2 (Standard, bubblewrap-Sandbox als Benutzer wamo) oder lokal
# (nur ausdrücklich, ohne Abschottung, mit Warnung im Log)
WAMO_ENTWICKLUNG_ORT=
# SSH-Ziel (Standard wamo@192.168.178.136) und Schlüssel (Standard ~/.ssh/id_ed25519_wamo_jobs) für den Dispatcher
WAMO_ENTWICKLUNG_SSH_ZIEL=
WAMO_ENTWICKLUNG_SSH_SCHLUESSEL=
# Nur lokal: Ordner für Projekte von Claude Code (Standard: Benutzerordner/Projekte). Darf das WAMO-Repo
# weder enthalten noch darin liegen.
WAMO_PROJECTS_DIR=
# Zeitlimit je Entwicklungsauftrag in Sekunden (Standard 1800)
DEV_JOB_TIMEOUT_SECS=
# Claude Code erbt nur eine feste Liste von Umgebungsvariablen (PATH, Benutzerordner, ...).
# Weitere Namen hier kommagetrennt freigeben, z. B. GH_TOKEN, wenn gh kein Keyring nutzt.
WAMO_JOB_ENV_PASSTHROUGH=
# Projekt- und Job-Ordner bekommt der Wächter (dev_guard.py) als Argument, nicht über die Umgebung.
