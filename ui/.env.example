# Vorlage für ui/.env.local (echte Werte nur dort eintragen, .env.local nie committen).
#
# Supabase: eigener WAMO-Stack auf Sokrates-2 (selbst gehostet, Registrierung geschlossen).
# Unterwegs nur über WireGuard ins Büronetz erreichbar. HTTPS mit Zertifikat der WAMO-CA: Der Browser bzw.
# die Desktop-App vertraut ihm erst nach dem Import von infra/sokrates2/wamo-ca.crt in Windows
# (siehe infra/sokrates2/README.md, Abschnitt 5). Die CSP in next.config.ts übernimmt diese Adresse.
NEXT_PUBLIC_SUPABASE_URL=https://192.168.178.136:55443
# Publishable Key im Format sb_publishable_... (für den Browser gedacht, Zugriff regelt RLS).
# Hier leer lassen, der Schlüssel kommt nur in ui/.env.local. Nie den service_role-Key verwenden.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Adresse des Voice-Core
NEXT_PUBLIC_VOICE_CORE_URL=http://localhost:7860

# Höchstalter der Anmeldung im Browser in ganzen Stunden (1 bis 168, Standard 24). Die Desktop-App gilt 7 Tage wie
# der Voice-Core (WAMO_ANMELDUNG_MAX_STUNDEN); erkannt wird sie an window.wamoDesktop, nicht an der Adresse.
NEXT_PUBLIC_WAMO_ANMELDUNG_MAX_STUNDEN_BROWSER=
