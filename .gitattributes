# Zeilenenden: Skripte, die auf Sokrates-2 (Linux) laufen, immer mit LF, auch beim Auschecken unter Windows
* text=auto
*.sh text eol=lf
*.sql text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
Caddyfile text eol=lf
*.caddy text eol=lf
*.yml text eol=lf
*.service text eol=lf
*.crt text eol=lf
*.nft text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.ico binary
*.pdf binary
*.service text eol=lf
*.timer text eol=lf
*.vorlage text eol=lf
*.beispiel text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.apparmor text eol=lf
*.socket text eol=lf
# Labor-Daten werden unverändert nach /etc/wamo-labor/daten installiert: LF, auch beim Auschecken unter Windows
infra/sokrates2/labor-daten/* text eol=lf
# Eingabe-Erweiterung des Remote-Desktop-Gateways: kommt unverändert ins JAR für Sokrates-2, LF auch unter Windows (test_rd_skripte.py)
infra/sokrates2/wamo-rd/erweiterung/*.json text eol=lf
infra/sokrates2/wamo-rd/erweiterung/*.js text eol=lf
infra/sokrates2/wamo-rd/erweiterung/*.css text eol=lf
