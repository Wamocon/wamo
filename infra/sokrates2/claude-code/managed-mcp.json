{
  "mcpServers": {
    "rea": {
      "type": "stdio",
      "command": "/srv/wamo/.npm-global/bin/rea-agents",
      "args": [
        "mcp"
      ],
      "env": {}
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GH_TOKEN:-}"
      }
    },
    "supabase": {
      "type": "stdio",
      "command": "/srv/wamo/.npm-global/bin/mcp-server-supabase",
      "args": [
        "--read-only"
      ]
    },
    "jira": {
      "type": "stdio",
      "command": "/srv/wamo/.local/bin/mcp-atlassian",
      "args": [],
      "env": {
        "JIRA_URL": "https://wamocon.atlassian.net",
        "JIRA_USERNAME": "${JIRA_EMAIL:-}",
        "JIRA_API_TOKEN": "${JIRA_API_KEY:-}",
        "READ_ONLY_MODE": "true"
      }
    }
  }
}
