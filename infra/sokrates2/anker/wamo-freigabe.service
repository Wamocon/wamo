# WAMO-Freigabe-Dienst auf Sokrates-2 (Schritt 1.4b der Selbstüberarbeitung). Installiert durch infra/sokrates2/freigabe-einrichten.sh,
# Rückweg: freigabe-rueckweg.sh.
#
# Läuft als unprivilegierter Systembenutzer wamo-anker, ohne jede Capability. Nimmt Freigaben von Admins entgegen (Konzept E.2): prüft
# das Token der Sitzung (Signatur gegen den Schlüsselsatz von GoTrue, aal2, zweiter Faktor höchstens 60 Sekunden alt) und schreibt die
# Freigabe in die Datenbank als Rolle wamo_anker_s2. Lauscht auf /run/wamo-freigabe/freigabe.sock (Ordner 2750 wamo-anker:wamocon, vom Typ
# tmpfiles.d; das Setgid-Bit gibt dem Socket die Gruppe wamocon, Modus 0660; zusätzlich SO_PEERCRED im Programm: nur die Benutzer aus
# WAMO_FREIGABE_PEERS, das sind root (0) und wamocon (1000), also der Container wamo-caddy, der als 1000:1000 läuft). Der Code liegt root-eigen
# unter /opt/wamo-freigabe/app, die Bibliotheken unter /opt/wamo-freigabe/pylib; vor jedem Start prüft ExecStartPre ihre Prüfsummen
# (fail closed).
#
# Netz nur zur Datenbank (Supavisor, 55322) und zum Schlüsselsatz (GoTrue hinter Caddy, 55443), beide auf 192.168.178.136. Docker
# setzt für veröffentlichte Ports ein DNAT auf die Container-Adresse (172.23.0.0/16 Supabase, 172.24.0.0/24 Caddy); der Filter von systemd
# sieht erst die umgesetzte Adresse, darum stehen die Docker-Netze hier. Genau die zwei Ziele und sonst nichts erzwingt die
# nft-Tabelle wamo_freigabe_ausgang (ct original, wamo-freigabe-ausgang.service, unten verlangt).
#
# Prüfpunkte, weil die Unit auf Sokrates-2 noch nicht erprobt wurde: systemd-analyze verify (macht das Einrichtungsskript),
# freigabe_rauchtest.py --produktiv. Startet der Dienst nicht, sind MemoryDenyWriteExecute und SystemCallFilter die ersten Verdächtigen
# (journalctl -u wamo-freigabe).
[Unit]
Description=WAMO-Freigabe-Dienst (Token, zweiter Faktor, Freigabe in die Datenbank)
Requires=wamo-freigabe-ausgang.service
After=wamo-freigabe-ausgang.service
ConditionPathExists=/opt/wamo-freigabe/app/SHA256SUMS
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=wamo-anker
Group=wamo-anker
ExecStartPre=/usr/bin/python3 -E -s -B /opt/wamo-freigabe/app/freigabe_dienst.py selbstpruefung
ExecStart=/usr/bin/python3 -E -s -B /opt/wamo-freigabe/app/freigabe_dienst.py dienst
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
WorkingDirectory=/
# Kein RuntimeDirectory=: Der Ordner /run/wamo-freigabe bleibt über Neustarts des Dienstes bestehen (tmpfiles.d, freigabe-einrichten.sh). Der
# Container wamo-caddy bindet ihn ein (Route /wamo/release/<id>/freigeben); ein RuntimeDirectory legte bei jedem Neustart einen neuen
# Ordner an, und Caddy sähe den alten ohne Socket.
ReadWritePaths=/run/wamo-freigabe
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUTF8=1
Environment=WAMO_FREIGABE_SCHEMA=wamo_dev
Environment=WAMO_FREIGABE_JWKS_URL=https://192.168.178.136:55443/auth/v1/.well-known/jwks.json
Environment=WAMO_FREIGABE_ISS=https://192.168.178.136:55443/auth/v1
Environment=WAMO_FREIGABE_AUD=authenticated
Environment=WAMO_FREIGABE_PEERS=0,1000
UMask=0077

# Der Dienst schreibt nichts außer dem Socket im eigenen Laufordner; Geheimnisordner anderer Dienste sind unsichtbar
InaccessiblePaths=-/etc/wamo -/etc/wamo-geraete -/etc/wamo-release
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=192.168.178.136/32 172.23.0.0/16 172.24.0.0/24
MemoryMax=256M
TasksMax=64
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
